---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnnouncementBar from '../../components/AnnouncementBar.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { DIARY_ENTRIES, type DiaryEntry } from '../../data/diary';

export async function getStaticPaths() {
  return DIARY_ENTRIES.map((entry, index) => {
    const prev = index > 0 ? DIARY_ENTRIES[index - 1] : DIARY_ENTRIES[DIARY_ENTRIES.length - 1];
    const next = index < DIARY_ENTRIES.length - 1 ? DIARY_ENTRIES[index + 1] : DIARY_ENTRIES[0];
    return {
      params: { slug: entry.slug },
      props: { entry, prev, next }
    };
  });
}

interface Props {
  entry: DiaryEntry;
  prev: DiaryEntry;
  next: DiaryEntry;
}

const { entry, prev, next } = Astro.props;
---

<BaseLayout
  title={`${entry.title} — Visual Diary — Verdant Hearth`}
  desc={entry.story.slice(0, 160)}
  ogImage={entry.heroImage}
>
  <AnnouncementBar />
  <Navbar />

  <main id="main-content" class="bg-[var(--bg-primary)]">
    <!-- Hero -->
    <div class="relative aspect-[21/9] max-h-[500px] overflow-hidden">
      <img
        src={entry.heroImage}
        alt={entry.title}
        width={1600}
        height={700}
        fetchpriority="high"
        onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)] via-transparent to-black/30"></div>
      <div class="absolute bottom-8 left-0 right-0 text-center">
        <span class="inline-block px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-[var(--accent-gold)] text-[var(--bg-dark)] mb-3">
          {entry.category}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white drop-shadow-lg max-w-3xl mx-auto px-4">
          {entry.title}
        </h1>
        <p class="text-sm text-white/80 mt-2">{entry.date} · Photo by {entry.photographer}</p>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <!-- Story -->
      <article class="prose-custom">
        <p class="text-base sm:text-lg text-[var(--text-main)] leading-relaxed font-medium">
          {entry.story}
        </p>
      </article>

      <!-- Gallery -->
      {entry.gallery.length > 1 && (
        <div class="mt-12">
          <h2 class="text-xs uppercase tracking-widest font-bold text-[var(--accent-gold)] mb-6">Gallery</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {entry.gallery.map((url, idx) => (
              <button
                type="button"
                class="diary-lightbox-trigger relative aspect-[4/3] rounded-2xl overflow-hidden bg-[var(--bg-muted)] border border-[var(--border-color)] group cursor-pointer"
                data-src={url}
                aria-label={`View photo ${idx + 1}`}
              >
                <img
                  src={url}
                  alt={`${entry.title} photo ${idx + 1}`}
                  width={800}
                  height={600}
                  loading="lazy"
                  onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <span class="text-white text-xs font-semibold">🔍 Expand</span>
                </div>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Lightbox Dialog -->
      <dialog id="diary-lightbox" class="backdrop:bg-black/90 bg-transparent p-4 max-w-4xl w-full m-auto">
        <div class="relative">
          <img id="diary-lb-img" src="" alt="" class="max-h-[80vh] max-w-full object-contain mx-auto rounded-xl" />
          <button
            id="diary-lb-close"
            type="button"
            class="absolute top-2 right-2 w-10 h-10 rounded-full bg-black/60 text-white flex items-center justify-center hover:bg-black/80 transition-colors"
            aria-label="Close lightbox"
          >
            ✕
          </button>
        </div>
      </dialog>

      <!-- Prev / Next -->
      <div class="flex items-center justify-between border-t border-b border-[var(--border-color)] py-6 mt-16">
        <a href={`/diary/${prev.slug}`} class="group flex items-center gap-3 max-w-[45%]">
          <span class="w-10 h-10 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] flex items-center justify-center text-[var(--text-muted)] group-hover:border-[var(--accent-gold)] group-hover:text-[var(--accent-gold)] transition-colors">←</span>
          <div>
            <span class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] block">Previous</span>
            <span class="text-sm font-bold text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors line-clamp-1">{prev.title}</span>
          </div>
        </a>
        <a href={`/diary/${next.slug}`} class="group flex items-center justify-end gap-3 text-right max-w-[45%]">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-[var(--text-muted)] block">Next</span>
            <span class="text-sm font-bold text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors line-clamp-1">{next.title}</span>
          </div>
          <span class="w-10 h-10 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] flex items-center justify-center text-[var(--text-muted)] group-hover:border-[var(--accent-gold)] group-hover:text-[var(--accent-gold)] transition-colors">→</span>
        </a>
      </div>

      <!-- Reserve CTA -->
      <div class="text-center mt-12">
        <a href="/reservation" class="btn-gold text-sm uppercase tracking-wider font-semibold py-4 px-8">
          Reserve Your Table
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<script>
  function setupDiaryLightbox() {
    const dialog = document.getElementById('diary-lightbox') as HTMLDialogElement | null;
    const img = document.getElementById('diary-lb-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('diary-lb-close');

    document.querySelectorAll<HTMLButtonElement>('.diary-lightbox-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-src');
        if (src && img && dialog) {
          img.src = src;
          img.alt = btn.getAttribute('aria-label') || '';
          dialog.showModal();
        }
      });
    });

    closeBtn?.addEventListener('click', () => dialog?.close());
    dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  }

  setupDiaryLightbox();
  document.addEventListener('astro:page-load', setupDiaryLightbox);
</script>
