---
import { HIGHLIGHTS_STRIP } from '../data/restaurant';

// Duplicate the array to enable seamless infinite linear scrolling
const marqueeItems = [...HIGHLIGHTS_STRIP, ...HIGHLIGHTS_STRIP];
---

<div
  class="relative overflow-hidden bg-[#0A1B12] text-[#F6F1E7] border-y border-[#1E4631] py-4 select-none"
  aria-label="Restaurant Highlights Marquee"
>
  <!-- Edge Gradient Masks for Soft Vignette -->
  <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-r from-[#0A1B12] to-transparent z-10"></div>
  <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-16 sm:w-28 bg-gradient-to-l from-[#0A1B12] to-transparent z-10"></div>

  <!-- Marquee Track -->
  <div class="animate-marquee flex items-center gap-8 sm:gap-12">
    {marqueeItems.map((item) => (
      <div class="flex items-center gap-4 shrink-0">
        <!-- Botanical Star Icon -->
        <span class="text-[#C9A15A] text-sm" aria-hidden="true">✦</span>
        <div class="flex items-baseline gap-2">
          <span class="font-serif font-bold text-sm sm:text-base tracking-wide text-[#F6F1E7]">
            {item.title}
          </span>
          <span class="text-xs text-[#A9C4A0] hidden sm:inline">
            — {item.subtitle}
          </span>
        </div>
      </div>
    ))}
  </div>
</div>

