---
import { MENU_CATEGORIES, FULL_MENU } from '../data/restaurant';

const dietaryFilters = [
  { id: 'all', label: 'All' },
  { id: 'GF', label: 'Gluten-Free' },
  { id: 'VG', label: 'Vegetarian' },
  { id: 'V', label: 'Vegan' },
  { id: 'spicy', label: 'Spicy' }
] as const;
---

<section id="menu" class="py-16 lg:py-24 bg-[var(--bg-primary)] border-b border-[var(--border-color)]" aria-labelledby="menu-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <span class="inline-block text-xs uppercase tracking-widest font-bold text-[var(--accent-gold)] mb-3 reveal-fade">
        Botanical & Live-Fire Repertoire
      </span>
      <h2 id="menu-heading" class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[var(--text-main)] tracking-tight leading-tight mb-4 reveal">
        Curated Hearth Menu
      </h2>
      <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed reveal" style="transition-delay: 150ms;">
        Every course honors our 42 regenerative partner farms, slow wood-smoke braising, and indigenous natural cellar pairings.
      </p>
    </div>

    <!-- Category Tabs -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-8" role="tablist" aria-label="Menu category selection">
      {MENU_CATEGORIES.map((cat, idx) => (
        <button
          type="button"
          role="tab"
          id={`tab-btn-${cat.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-category={cat.id}
          class={`menu-category-tab px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold tracking-wide transition-all cursor-pointer ${
            idx === 0
              ? 'bg-[#0F2A1D] text-[#F6F1E7] border border-[#0F2A1D] shadow-sm dark:bg-[#C9A15A] dark:text-[#0F2A1D]'
              : 'bg-[var(--bg-surface)] text-[var(--text-muted)] border border-[var(--border-color)] hover:border-[var(--accent-gold)] hover:text-[var(--text-main)]'
          }`}
        >
          {cat.name}
        </button>
      ))}
    </div>

    <!-- Secondary Dietary Quick Filter Chips -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <span class="text-xs text-[var(--text-muted)] font-medium mr-1 hidden sm:inline">Dietary:</span>
      {dietaryFilters.map((df, idx) => (
        <button
          type="button"
          data-dietary={df.id}
          class={`dietary-filter-chip px-3 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider transition-colors cursor-pointer ${
            idx === 0
              ? 'bg-[var(--brand-mid)]/15 text-[var(--accent-gold)] border border-[var(--brand-mid)]/30'
              : 'bg-transparent text-[var(--text-muted)] border border-transparent hover:border-[var(--border-color)]'
          }`}
        >
          {df.label}
        </button>
      ))}
    </div>

    <!-- Menu Items Grid -->
    <div id="menu-items-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 max-w-5xl mx-auto min-h-[420px]">
      {FULL_MENU.map((item) => (
        <a
          href={`/menu/${item.slug}`}
          class="menu-item-card card-clean p-6 flex flex-col justify-between transition-all duration-300 group hover:border-[var(--accent-gold)] hover:shadow-lg"
          data-category={item.category}
          data-dietary={item.dietary.join(',')}
        >
          <div>
            <div class="flex items-baseline justify-between gap-4 border-b border-dashed border-[var(--border-color)] pb-2 mb-2">
              <h3 class="text-lg sm:text-xl font-bold text-[var(--text-main)] group-hover:text-[var(--accent-gold)] transition-colors flex items-center gap-2">
                <span>{item.name}</span>
                {item.highlight && (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#C9A15A]/20 text-[#C9A15A] font-semibold uppercase tracking-wider">
                    Feature
                  </span>
                )}
                {item.seasonal && (
                  <span class="text-[10px] px-2 py-0.5 rounded-full bg-[#2A6647]/20 text-[#2A6647] dark:text-[#A9C4A0] font-semibold uppercase tracking-wider">
                    Spring
                  </span>
                )}
              </h3>
              <span class="text-lg font-extrabold text-[var(--accent-gold)] shrink-0">
                ${item.price}
              </span>
            </div>

            <!-- Dietary Badges -->
            <div class="flex items-center gap-1.5 mb-2.5">
              {item.dietary.map((tag) => (
                <span class="inline-block px-1.5 py-0.5 rounded text-[9px] font-bold tracking-wider uppercase bg-[var(--brand-mid)]/10 text-[var(--accent-gold)] border border-[var(--brand-mid)]/20">
                  {tag}
                </span>
              ))}
            </div>

            <p class="text-xs sm:text-sm text-[var(--text-muted)] leading-relaxed">
              {item.shortDescription}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-[var(--border-color)]/60 flex items-center justify-between text-[11px] text-[var(--text-muted)]">
            {item.pairing ? (
              <span class="flex items-center gap-1.5 truncate max-w-[80%]">
                <span class="text-[var(--accent-gold)]">🍷</span>
                <span class="truncate"><strong>Pairing:</strong> {item.pairing}</span>
              </span>
            ) : (
              <span>Prepared over live embers</span>
            )}
            <span class="text-[var(--accent-gold)] font-bold group-hover:translate-x-1 transition-transform">
              Details →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty State Fallback -->
    <div id="menu-empty-message" class="hidden text-center py-16 text-[var(--text-muted)]">
      <p class="text-base font-medium">No dishes match the selected dietary criteria in this category.</p>
      <button
        id="menu-reset-filter"
        type="button"
        class="mt-3 text-xs uppercase tracking-wider font-semibold text-[var(--accent-gold)] underline cursor-pointer"
      >
        Reset Dietary Filters
      </button>
    </div>

    <!-- View Full Menu CTA Row -->
    <div class="mt-14 text-center">
      <a
        href="/menu"
        class="btn-forest text-xs uppercase tracking-wider font-bold py-3.5 px-8 inline-flex items-center gap-2"
      >
        <span>Explore Full Menu & Detail Pages</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>

  </div>
</section>

<script>
  function setupMenuSection() {
    const categoryTabs = document.querySelectorAll<HTMLButtonElement>('.menu-category-tab');
    const dietaryChips = document.querySelectorAll<HTMLButtonElement>('.dietary-filter-chip');
    const menuItems = document.querySelectorAll<HTMLElement>('.menu-item-card');
    const emptyMsg = document.getElementById('menu-empty-message');
    const resetBtn = document.getElementById('menu-reset-filter');

    let activeCategory = 'starters';
    let activeDietary = 'all';

    function renderFilteredItems() {
      let visibleCount = 0;

      menuItems.forEach((card) => {
        const itemCat = card.getAttribute('data-category');
        const dietaryTags = (card.getAttribute('data-dietary') || '').split(',');

        const matchesCategory = itemCat === activeCategory;
        const matchesDietary = activeDietary === 'all' || dietaryTags.includes(activeDietary);

        if (matchesCategory && matchesDietary) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyMsg) {
        emptyMsg.classList.toggle('hidden', visibleCount > 0);
      }
    }

    categoryTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeCategory = tab.getAttribute('data-category') || 'starters';

        categoryTabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('bg-[#0F2A1D]', 'text-[#F6F1E7]', 'border-[#0F2A1D]', 'dark:bg-[#C9A15A]', 'dark:text-[#0F2A1D]');
          t.classList.add('bg-[var(--bg-surface)]', 'text-[var(--text-muted)]', 'border-[var(--border-color)]');
        });

        tab.setAttribute('aria-selected', 'true');
        tab.classList.remove('bg-[var(--bg-surface)]', 'text-[var(--text-muted)]', 'border-[var(--border-color)]');
        tab.classList.add('bg-[#0F2A1D]', 'text-[#F6F1E7]', 'border-[#0F2A1D]', 'dark:bg-[#C9A15A]', 'dark:text-[#0F2A1D]');

        renderFilteredItems();
      });
    });

    dietaryChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        activeDietary = chip.getAttribute('data-dietary') || 'all';

        dietaryChips.forEach((c) => {
          c.classList.remove('bg-[var(--brand-mid)]/15', 'text-[var(--accent-gold)]', 'border-[var(--brand-mid)]/30');
          c.classList.add('bg-transparent', 'text-[var(--text-muted)]', 'border-transparent');
        });

        chip.classList.add('bg-[var(--brand-mid)]/15', 'text-[var(--accent-gold)]', 'border-[var(--brand-mid)]/30');
        chip.classList.remove('bg-transparent', 'text-[var(--text-muted)]', 'border-transparent');

        renderFilteredItems();
      });
    });

    resetBtn?.addEventListener('click', () => {
      activeDietary = 'all';
      dietaryChips.forEach((c, idx) => {
        if (idx === 0) {
          c.classList.add('bg-[var(--brand-mid)]/15', 'text-[var(--accent-gold)]', 'border-[var(--brand-mid)]/30');
          c.classList.remove('bg-transparent', 'text-[var(--text-muted)]', 'border-transparent');
        } else {
          c.classList.remove('bg-[var(--brand-mid)]/15', 'text-[var(--accent-gold)]', 'border-[var(--brand-mid)]/30');
          c.classList.add('bg-transparent', 'text-[var(--text-muted)]', 'border-transparent');
        }
      });
      renderFilteredItems();
    });

    renderFilteredItems();
  }

  setupMenuSection();
  document.addEventListener('astro:page-load', setupMenuSection);
</script>
