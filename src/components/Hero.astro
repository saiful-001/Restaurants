---
import { IMAGES } from '../data/images';
import { RESTAURANT_INFO, HERO_ROTATING_WORDS } from '../data/restaurant';
---

<section
  id="hero"
  class="relative z-10 overflow-hidden pt-8 pb-16 lg:pt-14 lg:pb-24 border-b border-[var(--border-color)] bg-[var(--bg-primary)] text-[var(--text-main)]"
  aria-labelledby="hero-heading"
>
  <!-- Ambient background glow elements -->
  <div class="pointer-events-none absolute top-10 left-1/4 w-96 h-96 rounded-full bg-[var(--accent-gold)]/5 blur-3xl -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute bottom-10 right-10 w-[30rem] h-[30rem] rounded-full bg-[var(--accent-sage)]/10 blur-3xl -z-10" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy, Staggered Reveal + Auto-Changing Title, CTAs -->
      <div class="lg:col-span-6 flex flex-col items-start z-10">
        
        <!-- Eyebrow line with gold rule -->
        <div class="flex items-center gap-3 sm:gap-4 mb-6 w-full reveal-fade">
          <span class="text-[11px] sm:text-xs uppercase tracking-[0.22em] font-bold text-[var(--accent-gold)] whitespace-nowrap">
            Portland, Oregon · Established 2012
          </span>
          <span class="h-[1px] bg-gradient-to-r from-[var(--accent-gold)] to-transparent flex-1 max-w-[140px] sm:max-w-[180px]"></span>
        </div>

        <!-- Accessible Auto-Changing Headline with Fixed Gaps & Theme Font Style -->
        <h1
          id="hero-heading"
          class="font-serif text-4xl sm:text-5xl xl:text-6xl font-normal tracking-tight text-[var(--text-main)] leading-[1.18] mb-6"
          aria-label="Where Flames & Earth Meet: Savor, Gather, Celebrate, Linger, Discover at the Hearth."
        >
          <!-- Line 1: Lead Initial Stagger Words with explicit flex gaps -->
          <span class="inline-flex flex-wrap items-baseline gap-x-2.5 sm:gap-x-3.5 gap-y-1 mb-2" aria-hidden="true">
            <span class="hero-word-wrap">
              <span class="hero-word inline-block font-normal text-[var(--text-main)]" style="transition-delay: 80ms;">
                Where
              </span>
            </span>
            <span class="hero-word-wrap">
              <span class="hero-word inline-block italic font-serif text-[var(--accent-gold)] font-normal" style="transition-delay: 150ms;">
                Flames
              </span>
            </span>
            <span class="hero-word-wrap">
              <span class="hero-word inline-block italic font-serif text-[var(--accent-gold)] font-normal" style="transition-delay: 220ms;">
                &amp;
              </span>
            </span>
            <span class="hero-word-wrap">
              <span class="hero-word inline-block italic font-serif text-[var(--accent-gold)] font-normal" style="transition-delay: 290ms;">
                Earth
              </span>
            </span>
            <span class="hero-word-wrap">
              <span class="hero-word inline-block font-normal text-[var(--text-main)]" style="transition-delay: 360ms;">
                Meet:
              </span>
            </span>
          </span>

          <!-- Line 2: Rotating Action Word + Suffix Words with explicit flex gaps -->
          <span class="inline-flex flex-wrap items-baseline gap-x-2.5 sm:gap-x-3.5 gap-y-1" aria-hidden="true">
            <!-- Dynamic Slot with reserved width to prevent layout shift -->
            <span
              class="hero-rotate-slot text-[var(--accent-gold)] font-serif italic text-left inline-block"
              style="min-width: 6.2ch;"
              aria-live="off"
            >
              {HERO_ROTATING_WORDS.map((word, idx) => (
                <span
                  class={`hero-rotate-word font-serif italic font-normal text-[var(--accent-gold)] ${idx === 0 ? 'is-active' : ''}`}
                  data-rotate-idx={idx}
                >
                  {word}
                </span>
              ))}
            </span>

            <!-- Suffix Words Reveal with explicit flex spacing -->
            <span class="hero-word-wrap">
              <span class="hero-word inline-block font-normal text-[var(--text-main)]" style="transition-delay: 450ms;">
                at
              </span>
            </span>
            <span class="hero-word-wrap">
              <span class="hero-word inline-block font-normal text-[var(--text-main)]" style="transition-delay: 520ms;">
                the
              </span>
            </span>
            <span class="hero-word-wrap">
              <span class="hero-word inline-block font-medium text-[var(--text-main)]" style="transition-delay: 590ms;">
                Hearth.
              </span>
            </span>
          </span>
        </h1>

        <!-- Uppercase Tagline -->
        <p class="text-xs sm:text-sm uppercase tracking-[0.2em] font-medium text-[var(--accent-gold)] mb-4 reveal" style="transition-delay: 420ms;">
          Wood-Fired Flavors &nbsp;/&nbsp; Seasonal Ingredients &nbsp;/&nbsp; Unforgettable Moments
        </p>

        <!-- Supporting Narrative Copy -->
        <p class="text-base sm:text-lg text-[var(--text-muted)] leading-relaxed max-w-xl mb-8 reveal" style="transition-delay: 450ms;">
          Welcome to <strong class="text-[var(--text-main)] font-semibold">{RESTAURANT_INFO.name}</strong>, where ancient live-fire hearth cooking meets biodynamic botanical agriculture. Savor wild morels, day-boat seafood, and heritage grains celebrating the natural rhythms of the Pacific Northwest.
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-10 reveal" style="transition-delay: 550ms;">
          <a
            href="/reservation"
            class="btn-gold text-sm uppercase tracking-wider font-semibold py-3.5 px-8"
          >
            <span>Reserve a Table</span>
            <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/menu"
            class="btn-outline-gold text-sm uppercase tracking-wider font-semibold py-3.5 px-8 text-center"
          >
            <span>Explore Menu</span>
          </a>
        </div>

        <!-- Opening Hours Live Hint -->
        <div class="flex items-center gap-3 text-xs sm:text-sm text-[var(--text-muted)] py-2 px-3.5 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-color)] mb-8 reveal-fade" style="transition-delay: 650ms;">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0"></span>
          <span>
            <strong class="text-[var(--text-main)] font-medium">Tonight's Service:</strong> Hearth dinner from 5:00 PM · Walk-ins & reservations welcome
          </span>
        </div>

      </div>

      <!-- Right Column: Asymmetric Floating Image Collage & Rotating Badge (Original Design & Animation) -->
      <div class="lg:col-span-6 relative mt-4 lg:mt-0">
        <!-- Parallax Container -->
        <div id="hero-parallax-stage" class="relative w-full max-w-lg mx-auto lg:max-w-none h-[440px] sm:h-[560px] lg:h-[620px]">
          
          <!-- Central Main Arch Image -->
          <div
            class="hero-collage-item hero-collage-main absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[62%] sm:w-[58%] h-[82%] rounded-t-[140px] sm:rounded-t-[180px] rounded-b-3xl overflow-hidden shadow-2xl border-4 border-[var(--bg-surface)] z-20"
            style="transition-delay: 200ms;"
          >
            <img
              src={IMAGES.heroMain.url}
              alt={IMAGES.heroMain.alt}
              width={IMAGES.heroMain.width}
              height={IMAGES.heroMain.height}
              fetchpriority="high"
              onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
              class="w-full h-full object-cover transform hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0F2A1D]/80 via-transparent to-transparent pointer-events-none"></div>
            <div class="absolute bottom-4 left-4 right-4 text-white text-xs sm:text-sm">
              <span class="font-bold block text-base text-[#F6F1E7]">The Grand Hearth Room</span>
              <span class="text-[#A9C4A0] text-[11px] tracking-wide font-medium">Live wood-ember cooking</span>
            </div>
          </div>

          <!-- Collage Accent 1: Top-Left Hearth Dish (Floating) -->
          <div
            class="hero-collage-item float-slow-1 hidden sm:block absolute top-2 left-0 sm:left-2 w-28 sm:w-36 h-28 sm:h-36 rounded-2xl overflow-hidden shadow-xl border-3 border-[var(--bg-surface)] z-30"
            data-depth="0.04"
            style="transition-delay: 340ms;"
          >
            <img
              src={IMAGES.heroAccent1.url}
              alt={IMAGES.heroAccent1.alt}
              width={IMAGES.heroAccent1.width}
              height={IMAGES.heroAccent1.height}
              loading="lazy"
              onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
              class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500"
            />
          </div>

          <!-- Collage Accent 2: Top-Right Botanical Cocktail (Floating) -->
          <div
            class="hero-collage-item float-slow-2 hidden sm:block absolute top-6 right-0 sm:right-3 w-28 sm:w-36 h-32 sm:h-40 rounded-2xl overflow-hidden shadow-xl border-3 border-[var(--bg-surface)] z-30"
            data-depth="-0.03"
            style="transition-delay: 440ms;"
          >
            <img
              src={IMAGES.heroAccent2.url}
              alt={IMAGES.heroAccent2.alt}
              width={IMAGES.heroAccent2.width}
              height={IMAGES.heroAccent2.height}
              loading="lazy"
              onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
              class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500"
            />
          </div>

          <!-- Collage Accent 3: Mid-Left Chef Plating Herbs (Hidden on mobile/tablet-, visible on desktop) -->
          <div
            class="hero-collage-item float-slow-3 hidden sm:block absolute bottom-24 -left-3 w-32 h-32 rounded-2xl overflow-hidden shadow-xl border-3 border-[var(--bg-surface)] z-30"
            data-depth="0.05"
            style="transition-delay: 520ms;"
          >
            <img
              src={IMAGES.heroAccent3.url}
              alt={IMAGES.heroAccent3.alt}
              width={IMAGES.heroAccent3.width}
              height={IMAGES.heroAccent3.height}
              loading="lazy"
              onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
              class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500"
            />
          </div>

          <!-- Collage Accent 4: Bottom-Right Wild Berry Dessert (Floating) -->
          <div
            class="hero-collage-item float-slow-1 hidden sm:block absolute bottom-4 right-2 sm:right-4 w-28 sm:w-36 h-28 sm:h-36 rounded-2xl overflow-hidden shadow-xl border-3 border-[var(--bg-surface)] z-30"
            data-depth="-0.04"
            style="transition-delay: 600ms;"
          >
            <img
              src={IMAGES.heroAccent4.url}
              alt={IMAGES.heroAccent4.alt}
              width={IMAGES.heroAccent4.width}
              height={IMAGES.heroAccent4.height}
              loading="lazy"
              onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
              class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500"
            />
          </div>

          <!-- Collage Accent 5: Bottom-Left Fresh Heirloom Botanicals (Hidden on small mobile) -->
          <div
            class="hero-collage-item float-slow-2 hidden sm:block absolute bottom-2 left-10 w-24 h-24 rounded-2xl overflow-hidden shadow-xl border-3 border-[var(--bg-surface)] z-30"
            data-depth="0.03"
            style="transition-delay: 680ms;"
          >
            <img
              src={IMAGES.heroAccent5.url}
              alt={IMAGES.heroAccent5.alt}
              width={IMAGES.heroAccent5.width}
              height={IMAGES.heroAccent5.height}
              loading="lazy"
              onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
              class="w-full h-full object-cover transform hover:scale-110 transition-transform duration-500"
            />
          </div>

          <!-- Rotating Circular Text Badge -->
          <div
            class="absolute -top-3 sm:top-2 left-1/4 sm:left-[22%] z-20 w-24 h-24 sm:w-28 sm:h-28 pointer-events-none"
            aria-hidden="true"
          >
            <div class="relative w-full h-full">
              <!-- SVG Circular Path with Rotating Text -->
              <svg class="w-full h-full spin-slow" viewBox="0 0 100 100">
                <defs>
                  <path
                    id="circlePath"
                    d="M 50, 50 m -36, 0 a 36,36 0 1,1 72,0 a 36,36 0 1,1 -72,0"
                  />
                </defs>
                <text font-size="9" font-weight="700" letter-spacing="2.2" fill="var(--accent-gold)">
                  <textPath xlink:href="#circlePath">
                    SEASONAL · WOOD-FIRED · BOTANICAL ·
                  </textPath>
                </text>
              </svg>
              <!-- Center Icon -->
              <div class="absolute inset-0 m-auto w-8 h-8 rounded-full bg-[#0F2A1D] border border-[#C9A15A] flex items-center justify-center text-[#C9A15A] shadow-md">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.5 6.5 6 11 6 15C6 18.31 8.69 21 12 21C15.31 21 18 18.31 18 15C18 11 15.5 6.5 12 2Z" />
                </svg>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- Bottom Stats Bar: 4.9 Stars, 14 Years, 42 Farms, Mountain Line Art, and Script Quote -->
    <div
      class="mt-12 sm:mt-16 pt-8 border-t border-[var(--border-color)]/70 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center reveal"
      style="transition-delay: 750ms;"
    >
      <!-- Left: 3 Animated Counter Metric Columns -->
      <div class="lg:col-span-7 grid grid-cols-3 gap-4 sm:gap-6 text-left">
        
        <!-- Metric 1: Rating -->
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-[var(--accent-gold)]/10 border border-[var(--accent-gold)]/30 flex items-center justify-center text-[var(--accent-gold)] shrink-0 mt-0.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 18h16" />
              <path d="M4 18a8 8 0 0 1 16 0" />
              <circle cx="12" cy="7" r="1.5" />
            </svg>
          </div>
          <div>
            <div class="flex items-baseline gap-1 text-[var(--text-main)]">
              <span class="stat-counter font-bold text-xl sm:text-2xl" data-target="4.9" data-decimals="1">4.9</span>
              <span class="text-xs text-[var(--accent-gold)] tracking-tighter">★★★★★</span>
            </div>
            <p class="text-[11px] sm:text-xs text-[var(--text-muted)] font-medium mt-0.5">
              1,450+ Verified Diners
            </p>
          </div>
        </div>

        <!-- Metric 2: Culinary Heritage -->
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-[var(--accent-gold)]/10 border border-[var(--accent-gold)]/30 flex items-center justify-center text-[var(--accent-gold)] shrink-0 mt-0.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2C8.5 6.5 6 11 6 15C6 18.31 8.69 21 12 21C15.31 21 18 18.31 18 15C18 11 15.5 6.5 12 2Z" />
            </svg>
          </div>
          <div>
            <div class="text-[var(--text-main)] font-bold text-xl sm:text-2xl">
              <span class="stat-counter" data-target="14">14</span>
              <span class="text-base font-semibold">Years</span>
            </div>
            <p class="text-[11px] sm:text-xs text-[var(--text-muted)] font-medium mt-0.5">
              Culinary Heritage
            </p>
          </div>
        </div>

        <!-- Metric 3: Farms -->
        <div class="flex items-start gap-3">
          <div class="w-9 h-9 rounded-full bg-[var(--accent-gold)]/10 border border-[var(--accent-gold)]/30 flex items-center justify-center text-[var(--accent-gold)] shrink-0 mt-0.5">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M7 20h10" />
              <path d="M12 20v-8" />
              <path d="M12 12a5 5 0 0 1 5-5c0 4.5-3 6.5-5 7" />
              <path d="M12 12a5 5 0 0 0-5-5c0 4.5 3 6.5 5 7" />
            </svg>
          </div>
          <div>
            <div class="text-[var(--text-main)] font-bold text-xl sm:text-2xl">
              <span class="stat-counter" data-target="42">42</span>
              <span class="text-base font-semibold">Farms</span>
            </div>
            <p class="text-[11px] sm:text-xs text-[var(--text-muted)] font-medium mt-0.5">
              Biodynamic Partners
            </p>
          </div>
        </div>

      </div>

      <!-- Right: Mountain Line Art Silhouette + Handwritten Script Quote -->
      <div class="lg:col-span-5 flex flex-col items-center lg:items-end justify-center">
        <!-- Handwritten Script Quote -->
        <div class="mb-2 text-center lg:text-right">
          <span class="font-script text-xl sm:text-2xl text-[var(--accent-gold)] font-medium tracking-wide">
            "Good Food Brings People Together"
          </span>
        </div>
        <!-- Mountain Silhouette Line Art SVG -->
        <div class="w-56 sm:w-64 h-12 text-[var(--accent-gold)]/60">
          <svg viewBox="0 0 260 50" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
            <path d="M5 45 L50 20 L80 32 L130 8 L170 30 L200 18 L255 45" />
            <path d="M130 8 L142 18 L125 24 L138 32" stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
            <path d="M50 20 L60 27 L45 31" stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
            <path d="M200 18 L208 24 L196 29" stroke-width="1" stroke-dasharray="2 3" opacity="0.6" />
          </svg>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  let heroRotateInterval: ReturnType<typeof setInterval> | null = null;

  document.addEventListener('astro:before-swap', () => {
    if (heroRotateInterval) {
      clearInterval(heroRotateInterval);
      heroRotateInterval = null;
    }
  });

  function setupHero() {
    if (heroRotateInterval) {
      clearInterval(heroRotateInterval);
      heroRotateInterval = null;
    }

    // Auto-Changing Hero Word Loop
    const rotateWords = document.querySelectorAll<HTMLElement>('.hero-rotate-word');
    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (rotateWords.length > 0) {
      rotateWords.forEach((w, i) => {
        if (i === 0) {
          w.classList.add('is-active');
          w.classList.remove('is-exiting');
        } else {
          w.classList.remove('is-active', 'is-exiting');
        }
      });
    }

    if (rotateWords.length > 1 && !isReducedMotion) {
      let currentIdx = 0;
      heroRotateInterval = setInterval(() => {
        const activeWord = rotateWords[currentIdx];
        if (!activeWord) return;
        activeWord.classList.remove('is-active');
        activeWord.classList.add('is-exiting');

        currentIdx = (currentIdx + 1) % rotateWords.length;
        const nextWord = rotateWords[currentIdx];

        setTimeout(() => {
          activeWord.classList.remove('is-exiting');
        }, 500);

        if (nextWord) {
          nextWord.classList.add('is-active');
        }
      }, 3200);
    }

    // Mouse Parallax Effect on Hero Stage (Desktop only)
    const stage = document.getElementById('hero-parallax-stage');
    const parallaxItems = stage?.querySelectorAll<HTMLElement>('[data-depth]');

    if (stage && parallaxItems && window.matchMedia('(min-width: 1024px) and (prefers-reduced-motion: no-preference)').matches) {
      let mouseX = 0;
      let mouseY = 0;
      let currentX = 0;
      let currentY = 0;
      let ticking = false;

      function onMouseMove(e: MouseEvent) {
        if (!stage) return;
        const rect = stage.getBoundingClientRect();
        mouseX = e.clientX - rect.left - rect.width / 2;
        mouseY = e.clientY - rect.top - rect.height / 2;

        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }

      function onMouseLeave() {
        mouseX = 0;
        mouseY = 0;
        if (!ticking) {
          requestAnimationFrame(updateParallax);
          ticking = true;
        }
      }

      stage.addEventListener('mousemove', onMouseMove);
      stage.addEventListener('mouseleave', onMouseLeave);

      function updateParallax() {
        currentX += (mouseX - currentX) * 0.08;
        currentY += (mouseY - currentY) * 0.08;

        parallaxItems?.forEach((el) => {
          const depth = parseFloat(el.getAttribute('data-depth') || '0.03');
          const moveX = currentX * depth;
          const moveY = currentY * depth;
          el.style.transform = `translate3d(${moveX}px, ${moveY}px, 0)`;
        });

        if (Math.abs(mouseX - currentX) > 0.1 || Math.abs(mouseY - currentY) > 0.1) {
          requestAnimationFrame(updateParallax);
        } else {
          ticking = false;
        }
      }
    }

    if (isReducedMotion) return;

    // Animated Count-Up for Stats
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const targetEl = entry.target as HTMLElement;
            const targetVal = parseFloat(targetEl.getAttribute('data-target') || '0');
            const decimals = parseInt(targetEl.getAttribute('data-decimals') || '0', 10);
            const duration = 1400;
            const startTime = performance.now();

            function updateCount(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const easeProgress = 1 - Math.pow(1 - progress, 4);
              const currentVal = easeProgress * targetVal;
              targetEl.textContent = currentVal.toFixed(decimals);

              if (progress < 1) {
                requestAnimationFrame(updateCount);
              } else {
                targetEl.textContent = targetVal.toFixed(decimals);
              }
            }

            requestAnimationFrame(updateCount);
            observer.unobserve(targetEl);
          }
        });
      },
      { threshold: 0.3 }
    );

    counters.forEach((el) => observer.observe(el));
  }

  document.addEventListener('astro:page-load', setupHero);
</script>
