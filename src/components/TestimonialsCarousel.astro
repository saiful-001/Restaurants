---
import { REVIEWS } from '../data/restaurant';
---

<section
  id="reviews"
  class="py-20 lg:py-28 bg-[var(--bg-primary)] border-b border-[var(--border-color)] relative overflow-hidden"
  aria-labelledby="reviews-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="reveal text-xs uppercase tracking-widest font-semibold text-[var(--accent-gold)] block mb-2">
        Critical Acclaim & Guest Words
      </span>
      <h2
        id="reviews-heading"
        class="reveal font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[var(--text-main)] mb-4"
      >
        Voices of the Hearth
      </h2>
      <p class="reveal text-sm sm:text-base text-[var(--text-muted)] leading-relaxed">
        Culinary critics and diners reflect on our wood-fired hearth flavors and botanical cellar experiences.
      </p>
      <span class="inline-block mt-2 text-[11px] text-[var(--text-muted)] opacity-70">
        *All reviews below are sample demo testimonials showcasing the marketplace template layout.
      </span>
    </div>

    <!-- Carousel Container -->
    <div
      id="testimonial-carousel"
      class="relative max-w-4xl mx-auto"
      aria-roledescription="carousel"
      aria-label="Critic and diner reviews"
    >
      <!-- Slides Wrapper -->
      <div class="overflow-hidden rounded-3xl">
        <div id="carousel-track" class="flex transition-transform duration-500 ease-out">
          {REVIEWS.map((review, idx) => (
            <div
              class="w-full shrink-0 px-2 sm:px-4"
              role="group"
              aria-roledescription="slide"
              aria-label={`Slide ${idx + 1} of ${REVIEWS.length}`}
            >
              <div class="card-clean p-8 sm:p-12 text-center flex flex-col items-center justify-between min-h-[320px] shadow-sm">
                <!-- Golden Rating Stars -->
                <div class="flex items-center gap-1 text-[var(--accent-gold)] text-lg mb-6" aria-label={`Rating: ${review.rating} out of 5 stars`}>
                  {'★'.repeat(review.rating)}
                </div>

                <!-- Quote Text -->
                <blockquote class="font-serif italic text-lg sm:text-2xl text-[var(--text-main)] leading-relaxed max-w-2xl mx-auto mb-6">
                  “{review.quote}”
                </blockquote>

                <!-- Reviewer Credentials -->
                <div>
                  <cite class="not-italic font-bold text-base text-[var(--text-main)] block">
                    {review.author}
                  </cite>
                  <span class="text-xs text-[var(--text-muted)] block mt-0.5">
                    {review.role} · <span class="text-[var(--accent-gold)] font-medium">{review.publication}</span>
                  </span>
                  <span class="inline-block mt-2 text-[11px] px-2.5 py-0.5 rounded-full bg-[var(--brand-mid)]/10 text-[var(--text-main)] border border-[var(--border-color)]">
                    Favorite Course: {review.dishLoved}
                  </span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Prev / Next Navigation Arrows -->
      <div class="flex items-center justify-between absolute top-1/2 -translate-y-1/2 -left-4 -right-4 sm:-left-6 sm:-right-6 pointer-events-none">
        <button
          id="carousel-prev"
          type="button"
          class="pointer-events-auto w-11 h-11 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-[var(--text-main)] hover:border-[var(--accent-gold)] hover:text-[var(--accent-gold)] shadow-md flex items-center justify-center transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-[#C9A15A]"
          aria-label="Previous review"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          id="carousel-next"
          type="button"
          class="pointer-events-auto w-11 h-11 rounded-full bg-[var(--bg-surface)] border border-[var(--border-color)] text-[var(--text-main)] hover:border-[var(--accent-gold)] hover:text-[var(--accent-gold)] shadow-md flex items-center justify-center transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-[#C9A15A]"
          aria-label="Next review"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <!-- Dot Indicators -->
      <div class="flex items-center justify-center gap-2.5 mt-8" role="tablist" aria-label="Review slider pagination">
        {REVIEWS.map((_, idx) => (
          <button
            type="button"
            role="tab"
            class="carousel-dot w-2.5 h-2.5 rounded-full transition-all duration-300 cursor-pointer focus-visible:outline-2 focus-visible:outline-[#C9A15A]"
            data-index={idx}
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-label={`Go to review ${idx + 1}`}
          />
        ))}
      </div>

    </div>

  </div>
</section>

<script>
  // Accessible Carousel Controller
  const track = document.getElementById('carousel-track');
  const prevBtn = document.getElementById('carousel-prev');
  const nextBtn = document.getElementById('carousel-next');
  const dots = document.querySelectorAll<HTMLButtonElement>('.carousel-dot');
  const totalSlides = dots.length;

  let currentSlide = 0;
  let autoplayTimer: ReturnType<typeof setInterval> | null = null;
  const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function updateCarousel(index: number) {
    if (index < 0) index = totalSlides - 1;
    if (index >= totalSlides) index = 0;
    currentSlide = index;

    if (track) {
      track.style.transform = `translateX(-${currentSlide * 100}%)`;
    }

    dots.forEach((dot, idx) => {
      if (idx === currentSlide) {
        dot.setAttribute('aria-selected', 'true');
        dot.className = 'carousel-dot w-8 h-2.5 rounded-full bg-[var(--accent-gold)] transition-all duration-300 cursor-pointer';
      } else {
        dot.setAttribute('aria-selected', 'false');
        dot.className = 'carousel-dot w-2.5 h-2.5 rounded-full bg-[var(--border-color)] hover:bg-[var(--accent-gold)]/60 transition-all duration-300 cursor-pointer';
      }
    });
  }

  // Initial setup
  updateCarousel(0);

  prevBtn?.addEventListener('click', () => {
    stopAutoplay();
    updateCarousel(currentSlide - 1);
  });

  nextBtn?.addEventListener('click', () => {
    stopAutoplay();
    updateCarousel(currentSlide + 1);
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      stopAutoplay();
      const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
      updateCarousel(idx);
    });
  });

  // Autoplay function
  function startAutoplay() {
    if (isReducedMotion) return;
    stopAutoplay();
    autoplayTimer = setInterval(() => {
      updateCarousel(currentSlide + 1);
    }, 6000);
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  // Pause on hover or focus
  const carouselEl = document.getElementById('testimonial-carousel');
  carouselEl?.addEventListener('mouseenter', stopAutoplay);
  carouselEl?.addEventListener('mouseleave', startAutoplay);
  carouselEl?.addEventListener('focusin', stopAutoplay);
  carouselEl?.addEventListener('focusout', startAutoplay);

  // Keyboard navigation
  carouselEl?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') {
      stopAutoplay();
      updateCarousel(currentSlide - 1);
    } else if (e.key === 'ArrowRight') {
      stopAutoplay();
      updateCarousel(currentSlide + 1);
    }
  });

  // Touch Swipe Support
  let touchStartX = 0;
  let touchEndX = 0;

  carouselEl?.addEventListener('touchstart', (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  carouselEl?.addEventListener('touchend', (e) => {
    touchEndX = e.changedTouches[0].screenX;
    if (touchStartX - touchEndX > 45) {
      stopAutoplay();
      updateCarousel(currentSlide + 1);
    } else if (touchEndX - touchStartX > 45) {
      stopAutoplay();
      updateCarousel(currentSlide - 1);
    }
  }, { passive: true });

  // Start autoplay if allowed
  startAutoplay();
</script>

