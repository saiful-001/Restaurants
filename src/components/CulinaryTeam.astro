---
import { ARTISANS } from '../data/restaurant';

/**
 * Real craft-at-work photos from Unsplash (all Unsplash License - free commercial use).
 * Credits listed in CREDITS.md.
 */
const craftImages: Record<string, { url: string; alt: string }> = {
  'julian-thorne': {
    url: 'https://images.unsplash.com/photo-1556910103-1c02745aae4d?auto=format&fit=crop&w=800&q=80',
    alt: 'Chef hands plating food with precision over a white plate'
  },
  'elena-rostova': {
    url: 'https://images.unsplash.com/photo-1607631568010-a87245c0daf8?auto=format&fit=crop&w=800&q=80',
    alt: 'Baker hands kneading artisan bread dough on a floured surface'
  },
  'matthieu-laurent': {
    url: 'https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?auto=format&fit=crop&w=800&q=80',
    alt: 'Sommelier pouring red wine into a crystal glass in a cellar'
  },
  'marcus-rivera': {
    url: 'https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&fit=crop&w=800&q=80',
    alt: 'Close-up of grilled meat being prepared over open flames'
  },
  'clara-sterling': {
    url: 'https://images.unsplash.com/photo-1466637574441-749b8f19452f?auto=format&fit=crop&w=800&q=80',
    alt: 'Hands sorting through fresh harvested vegetables and herbs'
  },
  'thomas-lind': {
    url: 'https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=800&q=80',
    alt: 'Freshly baked artisan sourdough loaves cooling on a wooden rack'
  }
};
---

<section
  id="team"
  class="py-20 lg:py-28 bg-[var(--bg-dark)] text-[var(--text-on-dark)] border-b border-[var(--border-dark)] relative"
  aria-labelledby="team-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="reveal text-xs uppercase tracking-widest font-semibold text-[var(--accent-gold)] block mb-2">
        Artisans of Flame & Earth
      </span>
      <h2
        id="team-heading"
        class="reveal font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4"
      >
        Meet the Culinary Masters
      </h2>
      <p class="reveal text-sm sm:text-base text-[var(--text-on-dark-muted)] leading-relaxed">
        Led by passion for wood-fired gastronomy and seasonal botanicals, our culinary team transforms raw terroir into unforgettable dining memories.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {ARTISANS.map((artisan, idx) => {
        const photo = craftImages[artisan.slug];
        return (
          <a
            href={`/artisans/${artisan.slug}`}
            class="reveal card-dark flex flex-col overflow-hidden group focus-visible:ring-2 focus-visible:ring-[var(--accent-gold)] hover:border-[var(--accent-gold)] transition-all duration-300"
            style={`transition-delay: ${(idx % 3) * 120}ms;`}
          >
            <div class="relative aspect-[4/3] overflow-hidden bg-[var(--bg-dark)]">
              <img
                src={photo?.url || '/placeholder-dish.svg'}
                alt={photo?.alt || `Craft work by ${artisan.name}`}
                width={800}
                height={600}
                loading="lazy"
                onerror="this.onerror=null; this.src='/placeholder-dish.svg';"
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg-dark)] via-transparent to-transparent pointer-events-none"></div>
              <span class="absolute top-3 right-3 text-[10px] uppercase font-bold tracking-wider px-2.5 py-0.5 rounded-full bg-[var(--brand-mid)] text-[var(--text-on-dark-muted)] border border-[var(--border-dark)]">
                {artisan.craft.split('&')[0]}
              </span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-[var(--accent-gold)] block mb-1">
                  {artisan.role}
                </span>
                <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-[var(--accent-gold)] transition-colors mb-2">
                  {artisan.name}
                </h3>
                <p class="text-xs sm:text-sm text-[var(--text-on-dark-muted)] leading-relaxed line-clamp-3 mb-4">
                  {artisan.biography}
                </p>
              </div>

              <div>
                <div class="pt-4 border-t border-[var(--border-dark)] mb-3">
                  <span class="text-[10px] uppercase tracking-wider font-bold text-white/80 block mb-1.5">
                    Distinction
                  </span>
                  <span class="inline-block px-2 py-0.5 rounded text-[10px] font-medium bg-[var(--brand-mid)] text-[var(--text-on-dark-muted)] border border-[var(--border-dark)]">
                    ★ {artisan.accolades[0]}
                  </span>
                </div>
                <div class="text-xs font-bold text-[var(--accent-gold)] flex items-center gap-1 group-hover:translate-x-1.5 transition-transform">
                  <span>Meet Artisan & View Dishes</span>
                  <span>→</span>
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
