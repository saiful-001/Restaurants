---
import { RESTAURANT_INFO, NAVIGATION_LINKS } from '../data/restaurant';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#07130D] text-[#F6F1E7] border-t border-[#1E4631] pt-16 pb-12 text-sm relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-8 pb-12 border-b border-[#1E4631]/80">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-xl bg-[#0F2A1D] border border-[#C9A15A]/40 flex items-center justify-center text-[#C9A15A]">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M12 2C8 6 6 10 6 14C6 17.31 8.69 20 12 20C15.31 20 18 17.31 18 14C18 9 14 5 12 2Z" fill="#1F4D36" stroke="#C9A15A" stroke-width="1.5" />
                <path d="M12 18C10.5 18 9.5 16.8 9.5 15C9.5 13 11 11.5 12 10C13 11.5 14.5 13 14.5 15C14.5 16.8 13.5 18 12 18Z" fill="#C9A15A" />
              </svg>
            </div>
            <div>
              <span class="block font-serif text-2xl font-bold tracking-tight text-white leading-none">
                {RESTAURANT_INFO.name}
              </span>
              <span class="block text-[10px] uppercase tracking-[0.2em] font-medium text-[#C9A15A] mt-0.5">
                Wood-Fired & Botanical
              </span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-[#A9C4A0] leading-relaxed max-w-sm mb-6">
            An award-winning sanctuary devoted to live-fire cooking, biodynamic botanicals, and low-intervention natural wines.
          </p>

          <!-- Address & Contact -->
          <div class="text-xs text-[#D5E2D1] space-y-1">
            <p>{RESTAURANT_INFO.address.street}, {RESTAURANT_INFO.address.city}, {RESTAURANT_INFO.address.state} {RESTAURANT_INFO.address.zip}</p>
            <p>Hotline: <a href={`tel:${RESTAURANT_INFO.phone}`} class="text-[#C9A15A] hover:underline">{RESTAURANT_INFO.phone}</a></p>
            <p>Concierge: <a href={`mailto:${RESTAURANT_INFO.email}`} class="text-[#C9A15A] hover:underline">{RESTAURANT_INFO.email}</a></p>
          </div>
        </div>
      </div>

      <!-- Quick Links Sitemap -->
      <div class="lg:col-span-3">
        <h3 class="font-serif text-base font-bold text-white mb-4 uppercase tracking-wider text-xs">
          Explore Sanctuary
        </h3>
        <ul class="space-y-2.5 text-xs text-[#A9C4A0]">
          {NAVIGATION_LINKS.map((link) => (
            <li>
              <a href={link.href} class="hover:text-[#C9A15A] transition-colors flex items-center gap-1.5">
                <span class="text-[#C9A15A]/60">›</span>
                <span>{link.label}</span>
              </a>
            </li>
          ))}
          <li>
            <a href="/reservation" class="text-[#C9A15A] font-semibold hover:underline flex items-center gap-1.5">
              <span>›</span>
              <span>Online Reservations</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Hours Summary & Social -->
      <div class="lg:col-span-4">
        <h3 class="font-serif text-base font-bold text-white mb-4 uppercase tracking-wider text-xs">
          Service Hours
        </h3>
        <div class="space-y-2 text-xs text-[#A9C4A0] mb-6">
          <p><strong class="text-white">Mon – Wed:</strong> 5:00 PM – 10:00 PM</p>
          <p><strong class="text-white">Thu – Fri:</strong> 5:00 PM – 11:30 PM (Late Bar)</p>
          <p><strong class="text-white">Saturday:</strong> 10:30 AM – 11:30 PM</p>
          <p><strong class="text-white">Sunday:</strong> 11:00 AM – 9:00 PM</p>
        </div>

        <h4 class="text-xs uppercase tracking-wider font-bold text-white mb-2">
          Connect
        </h4>
        <div class="flex items-center gap-3 text-xs text-[#C9A15A]">
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            Instagram
          </a>
          <span class="text-[#1E4631]">·</span>
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            Facebook
          </a>
          <span class="text-[#1E4631]">·</span>
          <a href="https://opentable.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
            OpenTable
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Bar: Dynamic Year, Disclaimer, Back to Top -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#A9C4A0]">
      <div class="text-center sm:text-left">
        <p>© {currentYear} {RESTAURANT_INFO.name}. All rights reserved.</p>
        <p class="text-[11px] opacity-60 mt-1">
          Sample content for demonstration.
        </p>
      </div>

      <!-- Back to Top Button -->
      <button
        id="back-to-top-btn"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-[#1E4631] bg-[#0F2A1D] text-[#C9A15A] hover:bg-[#1F4D36] hover:text-white transition-all cursor-pointer focus-visible:outline-2 focus-visible:outline-[#C9A15A]"
        aria-label="Scroll to top of page"
      >
        <span>Back to Top</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18" />
        </svg>
      </button>
    </div>

  </div>
</footer>

<script>
  function initFooter() {
    const backToTopBtn = document.getElementById('back-to-top-btn');
    if (backToTopBtn) {
      backToTopBtn.onclick = () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      };
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initFooter();
  }
  document.addEventListener('astro:page-load', initFooter);
</script>
