---
import { ANNOUNCEMENT } from '../data/restaurant';
---

<aside
  id="announcement-bar"
  class="relative z-50 bg-[#0A1B12] text-[#F6F1E7] border-b border-[#1E4631] text-xs sm:text-sm py-2.5 px-4 transition-all duration-300 ease-out"
  aria-label="Announcement"
>
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <div class="flex items-center gap-2.5 mx-auto text-center flex-wrap justify-center">
      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold tracking-wide uppercase bg-[#C9A15A]/20 text-[#C9A15A] border border-[#C9A15A]/30">
        {ANNOUNCEMENT.badge}
      </span>
      <span class="text-[#D5E2D1] hidden sm:inline">
        {ANNOUNCEMENT.text}
      </span>
      <span class="text-[#D5E2D1] sm:hidden">
        Spring botanical pairings are now live.
      </span>
      <a
        href={ANNOUNCEMENT.ctaLink}
        class="inline-flex items-center gap-1 font-semibold text-[#C9A15A] hover:text-[#E2C285] underline underline-offset-4 transition-colors ml-1"
      >
        <span>{ANNOUNCEMENT.ctaText}</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <!-- Dismiss Button -->
    <button
      id="dismiss-announcement"
      type="button"
      class="text-[#A9C4A0] hover:text-white p-1 rounded-md transition-colors focus-visible:outline-2 focus-visible:outline-[#C9A15A]"
      aria-label="Dismiss announcement"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</aside>

<script>
  function initAnnouncementBar() {
    const bar = document.getElementById('announcement-bar');
    const dismissBtn = document.getElementById('dismiss-announcement');

    try {
      if (sessionStorage.getItem('verdant-announcement-dismissed') === 'true') {
        if (bar) bar.style.display = 'none';
      }
    } catch (e) {}

    if (dismissBtn) {
      dismissBtn.onclick = () => {
        if (!bar) return;
        bar.style.maxHeight = `${bar.offsetHeight}px`;
        bar.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          bar.style.transition = 'max-height 0.3s ease, opacity 0.25s ease, padding 0.3s ease';
          bar.style.maxHeight = '0px';
          bar.style.opacity = '0';
          bar.style.paddingTop = '0px';
          bar.style.paddingBottom = '0px';
          setTimeout(() => {
            bar.style.display = 'none';
          }, 300);
        });
        try {
          sessionStorage.setItem('verdant-announcement-dismissed', 'true');
        } catch (e) {}
      };
    }
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    initAnnouncementBar();
  }
  document.addEventListener('astro:page-load', initAnnouncementBar);
</script>
