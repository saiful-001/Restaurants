---
import { SPECIAL_OFFERS } from '../data/restaurant';
---

<section
  id="events"
  class="py-20 lg:py-28 bg-[#0F2A1D] text-[#F6F1E7] border-b border-[#1E4631] relative"
  aria-labelledby="events-heading"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
      <span class="reveal text-xs uppercase tracking-widest font-semibold text-[#C9A15A] block mb-2">
        Gatherings & Celebrations
      </span>
      <h2
        id="events-heading"
        class="reveal font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white mb-4"
      >
        Special Offerings & Private Dining
      </h2>
      <p class="reveal text-sm sm:text-base text-[#A9C4A0] leading-relaxed">
        From twilight garden aperitifs to intimate 7-course hearth journeys, discover extraordinary dining experiences tailored for cherished moments.
      </p>
    </div>

    <!-- 3 Offer Cards Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {SPECIAL_OFFERS.map((offer, idx) => (
          <article
            class="reveal card-dark flex flex-col overflow-hidden group"
            style={`transition-delay: ${idx * 120}ms;`}
          >
            <!-- Event Image Container -->
            <div class="relative aspect-[16/10] overflow-hidden bg-[#0A1B12]">
              <img
                src={offer.image}
                alt={offer.title}
                width={700}
                height={500}
                loading="lazy"
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0F2A1D] via-transparent to-transparent pointer-events-none"></div>

              <!-- Schedule Tag -->
              <span class="absolute bottom-3 left-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-[#0F2A1D]/85 backdrop-blur-md text-[#C9A15A] border border-[#C9A15A]/40">
                <span class="w-1.5 h-1.5 rounded-full bg-[#C9A15A]"></span>
                {offer.schedule}
              </span>
            </div>

            <!-- Content Details -->
            <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-xs uppercase tracking-wider font-semibold text-[#A9C4A0] block mb-1">
                  {offer.tagline}
                </span>

                <h3 class="font-serif text-xl sm:text-2xl font-bold text-white group-hover:text-[#C9A15A] transition-colors mb-2">
                  {offer.title}
                </h3>

                <p class="text-xs sm:text-sm text-[#C9A15A] font-medium mb-4">
                  {offer.priceNote}
                </p>

                <p class="text-xs sm:text-sm text-[#A9C4A0] leading-relaxed mb-6">
                  {offer.description}
                </p>

                <!-- Feature Bullets -->
                <ul class="space-y-2 mb-6 text-xs text-[#D5E2D1]">
                  {offer.features.map((feat) => (
                    <li class="flex items-center gap-2">
                      <span class="text-[#C9A15A] text-xs">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Book Action -->
              <a
                href="/reservation"
                class="btn-gold w-full text-center text-xs uppercase tracking-wider font-semibold py-3"
              >
                <span>{offer.ctaText}</span>
              </a>
            </div>
          </article>
      ))}

    </div>

  </div>
</section>

