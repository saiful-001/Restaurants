---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { RESTAURANT_INFO } from '../data/restaurant';

interface Props {
  title?: string;
  desc?: string;
  ogImage?: string;
}

const {
  title = `${RESTAURANT_INFO.name} — ${RESTAURANT_INFO.tagline}`,
  desc = RESTAURANT_INFO.shortDesc,
  ogImage = 'https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=1200&q=80'
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : 'https://verdanthearth.example.com';

const restaurantSchema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  'name': RESTAURANT_INFO.name,
  'description': RESTAURANT_INFO.shortDesc,
  'image': ogImage,
  'telephone': RESTAURANT_INFO.phone,
  'email': RESTAURANT_INFO.email,
  'address': {
    '@type': 'PostalAddress',
    'streetAddress': RESTAURANT_INFO.address.street,
    'addressLocality': RESTAURANT_INFO.address.city,
    'addressRegion': RESTAURANT_INFO.address.state,
    'postalCode': RESTAURANT_INFO.address.zip,
    'addressCountry': 'US'
  },
  'servesCuisine': ['Botanical', 'Wood-Fired', 'Pacific Northwest', 'Farm-to-Table', 'Modern American'],
  'priceRange': '$$$',
  'hasMenu': `${new URL('/menu', canonicalURL).href}`,
  'openingHoursSpecification': [
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Monday', 'Tuesday', 'Wednesday'],
      'opens': '17:00',
      'closes': '22:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': ['Thursday', 'Friday'],
      'opens': '17:00',
      'closes': '23:30'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': 'Saturday',
      'opens': '10:30',
      'closes': '23:30'
    },
    {
      '@type': 'OpeningHoursSpecification',
      'dayOfWeek': 'Sunday',
      'opens': '11:00',
      'closes': '21:00'
    }
  ],
  'aggregateRating': {
    '@type': 'AggregateRating',
    'ratingValue': RESTAURANT_INFO.rating.toString(),
    'reviewCount': '1450',
    'bestRating': '5',
    'worstRating': '1'
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Social Sharing -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={RESTAURANT_INFO.name} />

    <!-- Twitter Meta -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(restaurantSchema)} />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Inline Head Theme Resolver to prevent theme flash (FOUC) and persist across page navigation -->
    <script is:inline>
      (function() {
        document.documentElement.classList.add('js');
        var themes = ['dark', 'light', 'ember', 'saffron'];

        function resolveTheme() {
          try {
            var stored = localStorage.getItem('verdant-theme');
            return (stored && themes.indexOf(stored) !== -1) ? stored : 'dark';
          } catch (e) {
            return 'dark';
          }
        }

        function applyCurrentTheme(targetEl) {
          var el = targetEl || document.documentElement;
          var theme = resolveTheme();
          el.setAttribute('data-theme', theme);
          if (theme === 'dark' || theme === 'ember') {
            el.classList.add('dark');
          } else {
            el.classList.remove('dark');
          }
        }

        // Apply immediately to current document
        applyCurrentTheme(document.documentElement);

        // Crucial for Astro View Transitions: apply to incoming document BEFORE swap
        document.addEventListener('astro:before-swap', function(e) {
          if (e && e.newDocument && e.newDocument.documentElement) {
            applyCurrentTheme(e.newDocument.documentElement);
          }
        });

        // Re-ensure on after-swap
        document.addEventListener('astro:after-swap', function() {
          applyCurrentTheme(document.documentElement);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[#C9A15A] selection:text-[#0F2A1D]">
    <slot />

    <!-- Animation & Lifecycle Trigger Script -->
    <script>
      let currentRevealObserver: IntersectionObserver | null = null;

      document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('js-loaded');
        if (currentRevealObserver) {
          currentRevealObserver.disconnect();
          currentRevealObserver = null;
        }
      });

      function initPageEnhancements() {
        // Remove js-loaded first to reset staggered words & collage animations
        document.documentElement.classList.remove('js-loaded');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            document.documentElement.classList.add('js-loaded');
          });
        });

        // Disconnect previous observer if any
        if (currentRevealObserver) {
          currentRevealObserver.disconnect();
        }

        // Scroll Reveal with IntersectionObserver
        currentRevealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('in');
                currentRevealObserver?.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: '20px 0px 20px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-fade').forEach((el, index) => {
          const htmlEl = el as HTMLElement;
          htmlEl.classList.remove('in');
          if (!htmlEl.style.transitionDelay) {
            htmlEl.style.transitionDelay = `${(index % 4) * 90}ms`;
          }
          currentRevealObserver?.observe(el);
        });
      }

      if (document.readyState === 'complete' || document.readyState === 'interactive') {
        initPageEnhancements();
      }
      document.addEventListener('astro:page-load', initPageEnhancements);
    </script>
  </body>
</html>
