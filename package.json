{
  "name": "verdant-hearth-restaurant-template",
  "type": "module",
  "version": "1.0.0",
  "description": "Production-grade, award-winning restaurant landing page template built with Astro 6, TypeScript, and Tailwind CSS 4.",
"scripts": {
  "dev": "astro dev",
  "build": "node ./node_modules/astro/astro.js check && node ./node_modules/astro/astro.js build",
  "preview": "astro preview"
},
  "allowScripts": {
    "esbuild": true,
    "sharp": true
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "6.1.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
